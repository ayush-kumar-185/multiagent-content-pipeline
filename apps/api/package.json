{
  "name": "@citewriter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts"
  },
  "dependencies": {
    "@citewriter/core": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "bullmq": "^6.5.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
