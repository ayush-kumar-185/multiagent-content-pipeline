# ==============================================================================
# CiteWriter Environment Variables
# ==============================================================================

# Database & Cache
DATABASE_URL=postgresql://citewriter:citewriter_dev_password@localhost:5433/citewriter
REDIS_URL=redis://localhost:6379

# Service Ports & URLs
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# Agent Models & Platform Providers
# Architecture matrix:
# - Researcher: Gemini Flash (or Groq llama-3.3-70b-versatile) for fast tool calling
# - Writer: Cerebras llama3.3-70b (or Groq / Gemini) for highest prose quality
# - Fact-checker: Gemini Flash for careful reading & large context window
# - Editor: Gemini Flash-Lite (or Ollama llama3.2) for fast rubric evaluation
RESEARCHER_PROVIDER=gemini
RESEARCHER_MODEL=gemini-2.5-flash

WRITER_PROVIDER=cerebras
WRITER_MODEL=llama3.3-70b

FACT_CHECKER_PROVIDER=gemini
FACT_CHECKER_MODEL=gemini-2.5-flash

EDITOR_PROVIDER=gemini
EDITOR_MODEL=gemini-2.5-flash-lite

# LLM Platform API Keys & Endpoints:
# 1. Google AI Studio (Gemini API)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. Groq
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. Cerebras
# Get your key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# 4. Ollama (Local free inference)
# Run locally: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# 5. Direct OpenAI (Optional)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Search Tools (Tavily or Brave behind an interface)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Budget Guard Limits (per run)
MAX_RUN_TOKENS=100000
MAX_RUN_COST_USD=1.50

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Authentication (Auth.js)
AUTH_SECRET=changeme_in_production_min_32_chars_random_string
NEXTAUTH_URL=http://localhost:3000
