# ==============================================================================
# CiteWriter Environment Variables
# ==============================================================================

# Database & Cache
DATABASE_URL=postgresql://citewriter:citewriter_dev_password@localhost:5433/citewriter
REDIS_URL=redis://localhost:6379

# Service Ports & URLs
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# Agent Models (provider-agnostic wrapper reads these per agent)
RESEARCHER_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o
FACT_CHECKER_MODEL=gpt-4o-mini
EDITOR_MODEL=gpt-4o

# LLM Provider API Keys & Base URLs (OpenAI, OpenRouter, Anthropic, Gemini)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search Tools (Tavily or Brave behind an interface)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Budget Guard Limits (per run)
MAX_RUN_TOKENS=100000
MAX_RUN_COST_USD=1.50

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Authentication (Auth.js)
AUTH_SECRET=changeme_in_production_min_32_chars_random_string
NEXTAUTH_URL=http://localhost:3000

