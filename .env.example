# ==============================================================================
# CiteWriter Environment Variables
# ==============================================================================

# Database & Cache
DATABASE_URL=postgresql://citewriter:citewriter_dev_password@localhost:5433/citewriter
DATABASE_URL_TEST=postgresql://citewriter:citewriter_dev_password@localhost:5433/citewriter_test
REDIS_URL=redis://localhost:6379

# Public Demo Access Code & Rate Caps
ACCESS_CODE=citewriter_demo_2026
NEXT_PUBLIC_ACCESS_CODE=citewriter_demo_2026
MAX_RUNS_PER_DAY=10
MAX_CONCURRENT_RUNS=1
MAX_RUNS_PER_IP_PER_DAY=5
LEDGER_HEADROOM_TOKENS=25000

# Execution Mode (explicit real vs mock)
USE_REAL_LLM=false

# Service Ports & URLs
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# Agent Models & Platform Providers
# Architecture matrix:
# - Researcher: Groq openai/gpt-oss-20b for fast tool calling & note extraction
# - Writer: Groq qwen/qwen3.8-27b for high prose quality & claim formatting
# - Fact-checker: Groq openai/gpt-oss-120b for strict claim verification
# - Editor: Google Gemini gemini-3.1-flash-lite for rubric evaluation
RESEARCHER_PROVIDER=groq
RESEARCHER_MODEL=openai/gpt-oss-20b
RESEARCHER_MAX_TOKENS=2000
RESEARCHER_REASONING_EFFORT=low
RESEARCHER_PAGE_TOKEN_BUDGET=500

WRITER_PROVIDER=groq
WRITER_MODEL=qwen/qwen3.8-27b
WRITER_MAX_TOKENS=2500
WRITER_REASONING_EFFORT=none

FACT_CHECKER_PROVIDER=groq
FACT_CHECKER_MODEL=openai/gpt-oss-120b
FACT_CHECKER_MAX_TOKENS=2500
FACT_CHECKER_REASONING_EFFORT=low

EDITOR_PROVIDER=gemini
EDITOR_MODEL=gemini-3.1-flash-lite
EDITOR_MAX_TOKENS=600
EDITOR_REASONING_EFFORT=low

# Token Audit & Instrumentation (set to 1 to record token metrics to token-audit/calls.jsonl)
TOKEN_AUDIT=1

# LLM Platform API Keys & Endpoints:
# 1. Google AI Studio (Gemini API)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. Groq
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. Cerebras
# Get your key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# 4. Ollama (Local free inference)
# Run locally: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# 5. Direct OpenAI (Optional)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Search Tools (Tavily or Brave behind an interface)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Budget Guard Limits (per run)
MAX_RUN_TOKENS=40000
MAX_RUN_COST_USD=1.50
TARGET_WORDS=500

# Daily Model Token Caps (for ledger pacing & warnings)
DAILY_TOKEN_LIMIT_OPENAI_GPT_OSS_20B=200000
DAILY_TOKEN_LIMIT_QWEN3_8_27B=200000
DAILY_TOKEN_LIMIT_OPENAI_GPT_OSS_120B=200000
# DAILY_TOKEN_LIMIT_GEMINI_3_1_FLASH_LITE: unknown (Google AI Studio does not publish a daily token ceiling)

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Authentication (Auth.js)
AUTH_SECRET=changeme_in_production_min_32_chars_random_string
NEXTAUTH_URL=http://localhost:3000

RESEARCHER_MAX_TOKENS=2000
RESEARCHER_REASONING_EFFORT=low
RESEARCHER_PAGE_TOKEN_BUDGET=500
RESEARCHER_MIN_QUOTE_WORDS=8
RESEARCHER_MAX_QUOTE_WORDS=60
WRITER_MAX_TOKENS=2500
WRITER_REASONING_EFFORT=none
FACT_CHECKER_MAX_TOKENS=2500
FACT_CHECKER_REASONING_EFFORT=low
EDITOR_MAX_TOKENS=600
EDITOR_REASONING_EFFORT=low
TOKEN_AUDIT=1
